# Game and multiplayer storage
REDIS_URL=redis://localhost:6379/0

# Neon Postgres connection string. Use the pooled connection string for production.
DATABASE_URL=postgresql://user:password@host.neon.tech/codebreaker?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret

# Set true behind HTTPS in production. Keep false for local HTTP development.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:13000,http://127.0.0.1:13000

# Reserved for the push-notification slice.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
