# Public API origin. This is safe to expose in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Browser-local accounts and social testing. Only honored on localhost; hosted origins always use the API.
NEXT_PUBLIC_ENABLE_LOCAL_FALLBACK=true

# Reserved for the push-notification slice. Never put the private VAPID key here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
